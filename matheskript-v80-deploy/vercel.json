{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/formeln",
      "destination": "/formeln/index.html"
    },
    {
      "source": "/formeln/:id",
      "destination": "/formeln/:id/index.html"
    },
    {
      "source": "/((?!api/)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!formeln|sitemap\\.xml|robots\\.txt).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/wochenmail",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/cron/push",
      "schedule": "0 15 * * *"
    }
  ]
}
